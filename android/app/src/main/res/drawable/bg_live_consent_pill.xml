<?xml version="1.0" encoding="utf-8"?>
<!-- 보호자 보기 허용 pill: 허용(activated) 시 파란 테두리 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_dark_veil" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1.5dp" android:color="@color/primary_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_dark_veil" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1dp" android:color="@color/overlay_white_20" />
        </shape>
    </item>
</selector>
