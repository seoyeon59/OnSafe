<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 곡률 스케일 — 역할 기준. 중첩 시 자식이 부모보다 작을 것.
         radius_pill은 요소 높이의 절반으로 자동 클램프되므로 크기와 무관하게 완전한 pill. -->
    <dimen name="radius_xs">6dp</dimen>      <!-- 체크박스 · 작은 배지 · 아이콘 버튼 -->
    <dimen name="radius_sm">12dp</dimen>     <!-- 카드 안 보조 섹션 · 소형 로고 -->
    <dimen name="radius_md">16dp</dimen>     <!-- 표준 카드 · 모달 · 행 (앱 기본값) -->
    <dimen name="radius_lg">24dp</dimen>     <!-- 화면을 채우는 큰 선택 카드 -->
    <dimen name="radius_pill">999dp</dimen>  <!-- 버튼 · 입력칸 · 배지 · 탭 · 프로그레스 -->

    <!-- 카메라 모드 사이드 패널 너비 -->
    <dimen name="side_panel_width">200dp</dimen>
    <!-- 카메라 모드 (가로) 에서 로그아웃 모달 최대 너비 -->
    <dimen name="logout_dialog_max_width">280dp</dimen>

    <!-- 타이포그래피 스케일 — 앱 전체에 흩어져 있던 10~40sp 13단계를 8단계로 정리 -->
    <dimen name="text_display">40sp</dimen>  <!-- 긴급 낙상 알림 카운트다운 전용 -->
    <dimen name="text_brand">28sp</dimen>    <!-- 로그인 화면 앱 이름 전용 -->
    <dimen name="text_title">20sp</dimen>    <!-- 화면 제목 -->
    <dimen name="text_button">18sp</dimen>   <!-- 주요 버튼 -->
    <dimen name="text_subtitle">16sp</dimen> <!-- 모달 제목 · 카드 제목 · 보조 버튼 -->
    <dimen name="text_body">14sp</dimen>     <!-- 본문·입력 라벨·검증 메시지 공통 -->
    <dimen name="text_caption">13sp</dimen>  <!-- 약관 등 부가 설명 -->
    <dimen name="text_tab">12sp</dimen>      <!-- 하단 탭 라벨 · 소형 배지 -->

    <!-- 간격 스케일 -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>

    <!-- 터치 대상 최소 크기 — Android 기준 48dp (iOS 44pt와 혼동 주의) -->
    <dimen name="touch_min">48dp</dimen>
</resources>
