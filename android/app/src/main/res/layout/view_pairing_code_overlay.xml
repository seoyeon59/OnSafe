<?xml version="1.0" encoding="utf-8"?>
<!--
    페어링 코드 오버레이 — 카메라 프리뷰 상단 중앙에 얹는다.
    자동 재발급 정책상 만료 UI는 필요 없고, 최초 로딩 중에는 코드 자리를 대시 6개로 표시.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pairingCodeOverlay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pairing_code_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보호자 연결 코드"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvPairingCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:letterSpacing="0.3"
        android:text="------"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnPairingCodeInfo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="페어링 코드 안내"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_info_details"
        android:tint="#FFFFFF" />

</LinearLayout>