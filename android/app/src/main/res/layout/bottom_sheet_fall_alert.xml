<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- 빨강 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_danger"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="20dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/overlay_white_25">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_siren"
                app:tint="@color/surface_white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="낙상 위험 감지!"
            android:textColor="@color/surface_white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="피보호자에게 이상 동작이 감지되었습니다."
            android:textColor="@color/surface_white"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- 흰 배경 본문 -->
    <LinearLayout
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp">

        <!-- 감지 시각 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/status_danger_soft">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/status_danger" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvDetectedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="감지 시각 · 오후 02:23"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 점수 카드 — 홈과 같은 공통 카드 -->
        <include
            android:id="@+id/alertRiskScoreCard"
            layout="@layout/include_risk_score_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- 119 신고하기 버튼 -->
        <LinearLayout
            android:clipToOutline="true"
            android:id="@+id/btn119Alert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/status_danger"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_pill_on_color"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_siren"
                app:tint="@color/surface_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="119 신고하기"
                android:textColor="@color/surface_white"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 확인했습니다 -->
        <TextView
            android:id="@+id/btnAlertDismiss"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/ripple_text_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="확인했습니다 (긴급상황 아님)"
            android:textColor="@color/ink_500"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
