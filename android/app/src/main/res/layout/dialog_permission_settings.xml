<?xml version="1.0" encoding="utf-8"?>
<!--
    권한 설정 이동 안내 다이얼로그
    AlertDialog.Builder 대신 앱 내 공통 다이얼로그 스타일로 통일
    (dialog_logout.xml, dialog_withdraw_account.xml 등과 동일한 패턴)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <!-- 아이콘 + 텍스트 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <!-- 자물쇠 아이콘 (파란 원형) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_primary_tint">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary_blue" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvPermDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="권한 설정이 필요합니다"
            android:textColor="@color/ink_900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 문구는 PermissionActivity에서 주입 -->
        <TextView
            android:id="@+id/tvPermDialogMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/ink_500"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <!-- 버튼 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPermDialogCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="나중에"
            android:textColor="#6B7280"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E5E7EB" />

        <TextView
            android:id="@+id/btnPermDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="설정으로 이동"
            android:textColor="@color/primary_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
