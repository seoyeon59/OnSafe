<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 썸네일 영역 (140dp) -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/border_subtle"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- 재생 아이콘 오버레이 -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_play"
                app:tint="@color/overlay_white_50" />

        </FrameLayout>

        <!-- 우측 콘텐츠 영역 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- 상단: 낙상 감지 표시 + 시간 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_danger" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="위험 감지"
                    android:textColor="@color/ink_900"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_500"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 하단: 버튼 행 (우측 끝 정렬) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 영상 보기 버튼 — 세 버튼 모두 40dp 높이 둥근 외곽선(터치 48dp) -->
                <LinearLayout
                    android:clipToOutline="true"
                    android:id="@+id/btnWatchVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_btn_round_blue"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:includeFontPadding="false"
                        android:text="영상 보기"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

                <!-- 다운로드 버튼 — 40dp 원 -->
                <ImageButton
                    android:clipToOutline="true"
                    android:id="@+id/btnDownload"
                    android:layout_width="40dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_round_neutral"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="영상 다운로드"
                    android:src="@drawable/ic_download"
                    app:tint="@color/ink_500" />

                <!-- 삭제 버튼 — 40dp 원 -->
                <ImageButton
                    android:clipToOutline="true"
                    android:id="@+id/btnDelete"
                    android:layout_width="40dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_round_danger"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="이력 삭제"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/status_danger_light" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
