<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <!-- 연결 아이콘 원형 -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_primary_tint">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_link"
                    app:tint="@color/primary_blue" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="보호자 연결 요청"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPairingRequestMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/ink_700"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="승인하면 낙상 알림과 사고 이력이 보호자에게 공유됩니다.\n모르는 사람의 요청이라면 거절해주세요."
                android:textColor="@color/ink_500"
                android:textSize="@dimen/text_caption" />

            <!-- 기존 보호자 교체 안내 — 이미 연결된 보호자가 있을 때만 표시 -->
            <TextView
                android:id="@+id/tvPairingRequestDisplaces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/status_danger"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/surface_bg"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbPairingLiveVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:minHeight="@dimen/touch_min"
                    android:text="실시간 영상 보기 허용 (선택)"
                    android:textColor="@color/ink_900"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:button="@drawable/sel_check_square"
                    app:buttonTint="@null"
                    android:paddingStart="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="32dp"
                    android:text="허용하면 보호자가 요청할 때 이 기기의 카메라 화면을 실시간으로 볼 수 있어요. 보호자가 요청하면 별도 확인 없이 카메라 영상이 전송되며, 전송 중에는 화면에 표시됩니다."
                    android:textColor="@color/ink_500"
                    android:textSize="@dimen/text_caption" />

                <!-- 이전 동의 유지 안내 -->
                <TextView
                    android:id="@+id/tvPairingLiveVideoCarried"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="32dp"
                    android:text="이전에 허용해 둔 설정이에요. 승인하면 이 보호자도 볼 수 있어요."
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- 버튼 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPairingReject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:paddingVertical="12dp"
            android:text="거절"
            android:textColor="@color/ink_500"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:background="@color/border_subtle" />

        <TextView
            android:id="@+id/btnPairingApprove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:paddingVertical="12dp"
            android:text="승인"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
