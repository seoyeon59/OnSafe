<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F11">

    <!-- ============ 좌측: 카메라 프리뷰 ============ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#0D0F11"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sidePanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 대기 중 / 연결 중 오버레이 (촬영 전에만 표시) -->
    <LinearLayout
        android:id="@+id/layoutStandby"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#0D0F11"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sidePanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 대기 중 콘텐츠: STANDBY / FAILED 상태에서만 표시 -->
        <LinearLayout
            android:id="@+id/layoutStandbyContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 카메라 아이콘 원형 배경 (10% blue) -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_circle_primary_tint" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:alpha="0.4"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/primary_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="촬영 대기 중"
                android:textColor="#80FEFEFE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 연결 중 콘텐츠: CONNECTING 상태에서만 표시 -->
        <LinearLayout
            android:id="@+id/layoutConnectingContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbConnecting"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="#FEFEFE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="연결 중..."
                android:textColor="#80FEFEFE"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ============ 상단 로고 (항상 표시) ============ -->
    <LinearLayout
        android:id="@+id/layoutLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- On-Safe 로고 아이콘 -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_logo" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield"
                app:tint="@color/surface_white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/gmarket_sans_bold"
            android:text="On-Safe"
            android:textColor="@color/primary_blue"
            android:textSize="16sp" />

        <!-- LIVE 뱃지 (전송 중에만 표시) -->
        <LinearLayout
            android:id="@+id/layoutLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_danger"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:visibility="gone">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="LIVE"
                android:textColor="#FEFEFE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 2e: 우하단 전체화면 버튼 ============ -->
    <FrameLayout
        android:id="@+id/btnFullscreen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_btn_overlay"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sidePanel">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/surface_white" />
    </FrameLayout>

    <!-- ============ 2e: 전체화면 복원 햄버거 버튼 (전체화면 모드에서만 표시) ============ -->
    <ImageButton
        android:id="@+id/btnHamburger"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_btn_overlay"
        android:contentDescription="@null"
        android:src="@drawable/ic_menu"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/surface_white" />

    <!-- ============ 우측 사이드 패널 ============ -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 패널 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#202327"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp"
            android:paddingStart="8dp">

            <!-- 카메라 아이콘 원형 -->
            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle_white_tint" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/primary_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="카메라 모드"
                android:textColor="#FEFEFE"
                android:textSize="12sp" />

            <!-- 튜토리얼 버튼 (설정 화면과 동일) -->
            <ImageView
                android:id="@+id/btnTutorial"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="튜토리얼"
                android:src="@drawable/ic_info"
                android:padding="2dp"
                app:tint="#80FEFEFE" />

        </LinearLayout>

        <!-- 패널 본문 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#EB0F1216"
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp">

            <!-- 연결 상태 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_semibold"
                    android:letterSpacing="0.09"
                    android:text="연결 상태"
                    android:textColor="#4DFFFFFF"
                    android:textSize="10sp" />

                <!-- 2c: 상태 뱃지 — cornerRadius=48 pill 유지 -->
                <LinearLayout
                    android:id="@+id/layoutStatusBadge"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_standby"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp"
                    android:paddingStart="12dp">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_dot_neutral" />

                    <TextView
                        android:id="@+id/tvStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="대기 중"
                        android:textColor="@color/status_standby"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 연결 정보 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_semibold"
                    android:letterSpacing="0.09"
                    android:text="연결 정보"
                    android:textColor="#4DFFFFFF"
                    android:textSize="10sp" />

                <!-- 연결 보호자 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:alpha="0.25"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person"
                            app:tint="@color/surface_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/pretendard_regular"
                            android:text="연결 보호자"
                            android:textColor="#4DFFFFFF"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGuardianName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="박지영"
                        android:textColor="#BFFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 기기 ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:alpha="0.25"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_devices"
                            app:tint="@color/surface_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/pretendard_regular"
                            android:text="기기 ID"
                            android:textColor="#4DFFFFFF"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDeviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="ONS-2026-0417"
                        android:textColor="#BFFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 스페이서 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ============ 버튼 영역 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="12dp"
                android:paddingStart="12dp">

                <!-- 2c/2d: 촬영 시작/종료 버튼 — pill shape + icon -->
                <LinearLayout
                    android:id="@+id/btnToggleRecording"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/primary_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivToggleIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/surface_white" />

                    <TextView
                        android:id="@+id/tvToggleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="촬영 시작하기"
                        android:textColor="@color/surface_white"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 2c/2d: 로그아웃 버튼 — pill outline + icon -->
                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_pill_outline_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:alpha="0.35"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_logout"
                        app:tint="@color/surface_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="로그아웃"
                        android:textColor="#59FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
