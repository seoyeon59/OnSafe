<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- 지도 핀 아이콘 -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_circle_primary_tint">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_location"
            app:tint="@color/primary_blue" />

    </FrameLayout>

    <!-- 주소 텍스트 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 우편번호 뱃지 — 최상단 -->
        <TextView
            android:id="@+id/tvZipNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_zip_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/primary_blue"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 도로명 주소 -->
        <TextView
            android:id="@+id/tvRoadAddr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_900"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 지번 주소 -->
        <TextView
            android:id="@+id/tvJibunAddr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_500"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
