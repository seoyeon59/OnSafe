<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_bg">

    <!-- 상단 네비게이션 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/surface_white"
        android:elevation="3dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            app:tint="@color/primary_blue" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="비밀번호 찾기"
            android:textSize="@dimen/text_title"
            android:textColor="@color/ink_900"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 뒤로가기 버튼과 같은 크기 — 제목 가운데 정렬 유지용 -->
        <View
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" />

    </LinearLayout>

    <!-- 본문 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- 입력 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp">

            <!-- 설명 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="가입한 아이디·이름·이메일이 모두 일치하면 새 비밀번호를 설정할 수 있습니다."
                android:textSize="@dimen/text_caption"
                android:textColor="@color/ink_500"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- 아이디 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_500"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- 아이디 입력 -->
            <EditText
                android:id="@+id/etUserId"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="아이디 입력"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_body"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_input_rounded"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <!-- 이름 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_500"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- 이름 입력 -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="홍길동"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_body"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_input_rounded"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <!-- 이메일 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일 주소"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_500"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- 이메일 입력 -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="example@email.com"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_body"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_input_rounded"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <!-- 본인 확인 — 성공 시 비밀번호 재설정 화면으로 이동 -->
            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="본인 확인"
                android:textColor="@color/surface_white"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- 여백 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- API 요청 중 로딩 인디케이터 -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />

        <!-- 로그인으로 돌아가기 — 보조 버튼(외곽선)으로 주 버튼과 위계 구분 -->
        <Button
            android:id="@+id/btnGoLogin"
            android:layout_width="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_height="@dimen/btn_height"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="로그인으로 돌아가기"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_blue"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>