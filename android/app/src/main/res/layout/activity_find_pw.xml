<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_bg">

    <!-- 상단 네비게이션 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/surface_white"
        android:elevation="3dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            app:tint="@color/primary_blue" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="비밀번호 찾기"
            android:textSize="@dimen/text_title"
            android:textColor="@color/ink_900"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 뒤로가기 버튼과 같은 크기 — 제목 가운데 정렬 유지용 -->
        <View
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" />

    </LinearLayout>

    <!-- 본문 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- 입력 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- 설명 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="가입한 아이디와 이메일 주소로 비밀번호 재설정 코드를 보냅니다."
                android:textSize="@dimen/text_caption"
                android:textColor="@color/ink_500"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- 아이디 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_500"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- 아이디 입력 -->
            <EditText
                android:id="@+id/etUserId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="아이디 입력"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_body"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_input_rounded"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <!-- 이메일 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일 주소"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_500"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- 이메일 입력 + 코드받기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="example@email.com"
                    android:textColor="@color/ink_900"
                    android:textSize="@dimen/text_body"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnRequestCode"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="코드 받기"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/surface_white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    android:layout_marginLeft="8dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

            </LinearLayout>

            <!-- 재설정 코드 입력칸 (코드받기 후 표시) -->
            <LinearLayout
                android:id="@+id/layoutCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="재설정 코드"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/ink_500"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <EditText
                            android:id="@+id/etCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="6자리 숫자"
                            android:textColor="@color/ink_900"
                            android:textSize="@dimen/text_body"
                            android:paddingLeft="16dp"
                            android:paddingRight="72dp"
                            android:background="@drawable/bg_input_rounded"
                            android:inputType="number"
                            android:maxLength="6"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:text="3:00"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/status_danger" />

                    </FrameLayout>

                    <Button
                        android:id="@+id/btnConfirm"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="확인"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/surface_white"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_blue"
                        android:layout_marginLeft="8dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                </LinearLayout>

                <!-- 재전송 버튼 (만료 시 표시) -->
                <TextView
                    android:id="@+id/tvResend"
                    android:minHeight="@dimen/touch_min"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인증코드 다시 받기"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/primary_blue"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- 여백 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- API 요청 중 로딩 인디케이터 -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />

        <!-- 로그인으로 돌아가기 -->
        <Button
            android:id="@+id/btnGoLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="로그인으로 돌아가기"
            android:textColor="@color/surface_white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_button_blue" />

    </LinearLayout>

</LinearLayout>