<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_white"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보호자 연결"
        android:textColor="@color/ink_900"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="피보호자 화면에 표시된 6자리 코드를 입력해주세요."
        android:textColor="@color/ink_500"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPairingCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@color/surface_bg"
        android:gravity="center"
        android:hint="------"
        android:inputType="number"
        android:letterSpacing="0.3"
        android:maxLength="6"
        android:padding="16dp"
        android:textColor="@color/ink_900"
        android:textColorHint="@color/ink_500"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPairingError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/status_danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pbPairingLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnPair"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@color/primary_blue"
        android:stateListAnimator="@null"
        android:text="연결하기"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>