<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보호자 연결"
        android:textColor="@color/ink_900"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="피보호자 화면에 표시된 6자리 코드를 입력해주세요."
        android:textColor="@color/ink_500"
        android:textSize="@dimen/text_caption" />

    <EditText
        android:id="@+id/etPairingCode"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_rounded"
        android:gravity="center"
        android:hint="------"
        android:inputType="number"
        android:letterSpacing="0.3"
        android:maxLength="6"
        android:paddingHorizontal="20dp"
        android:textColor="@color/ink_900"
        android:textColorHint="@color/track_off"
        android:textSize="@dimen/text_code"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPairingError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/status_danger_text"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pbPairingLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnPair"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:includeFontPadding="false"
        android:background="@drawable/bg_button_blue"
        android:stateListAnimator="@null"
        android:text="연결하기"
        android:textColor="@color/surface_white"
        android:textSize="@dimen/text_button"
        android:textStyle="bold" />

    <!-- 코드를 아직 못 받은 보호자가 홈으로 빠져나갈 수 있는 유일한 경로 -->
    <TextView
        android:id="@+id/btnPairLater"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_sm"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="나중에 하기"
        android:textColor="@color/ink_500"
        android:textSize="@dimen/text_body" />

</LinearLayout>