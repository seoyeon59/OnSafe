<?xml version="1.0" encoding="utf-8"?>
<!--
  하단 탭 바 공통 레이아웃 — 홈·사고이력·설정 세 화면이 include로 공유.
  활성 표시(pill 배경·채운 아이콘·강조색)와 화면 이동은 BottomNav.setupBottomNav()가 담당하므로
  여기서는 비활성 상태만 정의한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    android:background="@drawable/bg_sheet_top_rounded"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="40dp"
    android:paddingVertical="12dp"
    android:weightSum="3">

    <!-- 사고 이력 -->
    <LinearLayout
        android:id="@+id/tabHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabHistoryPill"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabHistoryIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_history" />

            <TextView
                android:id="@+id/tabHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="사고 이력"
                android:textSize="@dimen/text_tab"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 홈 -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabHomePill"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabHomeIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/tabHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="홈"
                android:textSize="@dimen/text_tab"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 설정 -->
    <LinearLayout
        android:id="@+id/tabSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabSettingsPill"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabSettingsIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/tabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="설정"
                android:textSize="@dimen/text_tab"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
