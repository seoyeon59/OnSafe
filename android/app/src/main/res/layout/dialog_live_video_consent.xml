<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_primary_tint">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/primary_blue" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="실시간 영상 보기를 허용할까요?"
                android:textColor="@color/ink_900"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="요청이 오면 확인 없이 영상이 전송돼요."
                android:textColor="@color/ink_500"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="전송 중엔 화면에 표시돼요."
                android:textColor="@color/ink_500"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>
    </ScrollView>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- 버튼 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnLiveConsentCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:paddingVertical="12dp"
            android:text="취소"
            android:textColor="@color/ink_500"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:background="@color/border_subtle" />

        <TextView
            android:id="@+id/btnLiveConsentConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:paddingVertical="12dp"
            android:text="허용"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
