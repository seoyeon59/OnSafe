<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="64dp"
        android:paddingBottom="64dp">

        <!-- 로고 영역 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- 로고 아이콘 (다른 화면과 동일한 라운드 사각 배경으로 통일) -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_logo_login">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_neulbom_logo"
                    android:contentDescription="늘봄 로고"
                    app:tint="@color/surface_white" />
            </FrameLayout>

            <!-- 앱 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="늘봄"
                android:includeFontPadding="false"
                android:textSize="28sp"
                android:textColor="#4D80FF"
                android:fontFamily="@font/pretendard_bold"
                android:layout_marginTop="10dp"
                android:letterSpacing="-0.025" />

            <!-- 서브타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가족의 안전을 언제나 함께 지켜드립니다"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- 입력 + 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <!-- 입력 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- 아이디 라벨 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아이디"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- 아이디 입력칸 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="16dp"
                        android:src="@drawable/ic_person"
                        android:contentDescription="아이디 아이콘"
                        app:tint="#6B7280" />

                    <EditText
                        android:id="@+id/etId"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="아이디 입력"
                        android:textColor="#1A1C1E"
                        android:textSize="14sp"
                        android:paddingLeft="45dp"
                        android:paddingRight="17dp"
                        android:background="@null"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </FrameLayout>

                <!-- 비밀번호 라벨 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp" />

                <!-- 비밀번호 입력칸 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="16dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="비밀번호 아이콘"
                        app:tint="#6B7280" />

                    <EditText
                        android:id="@+id/etPw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="비밀번호 입력"
                        android:textColor="#1A1C1E"
                        android:textSize="14sp"
                        android:paddingLeft="45dp"
                        android:paddingRight="49dp"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <!-- 비밀번호 표시/숨김 버튼 -->
                    <ImageButton
                        android:id="@+id/btnTogglePw"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/ic_eye"
                        android:background="@null"
                        android:contentDescription="비밀번호 보기"
                        app:tint="#6B7280" />
                </FrameLayout>

                <!-- 로그인 오류 메시지 -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#EF4444"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 로그인 버튼 -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="로그인"
                android:textColor="#FEFEFE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                android:layout_marginTop="16dp" />

            <!-- 로그인 중 로딩 인디케이터 -->
            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="gone" />

            <!-- !! DEBUG ONLY — 릴리즈 빌드에서는 코드로 gone 유지됨 !! -->
            <Button
                android:id="@+id/btnDebugLogin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:text="[DEBUG] 로그인 건너뛰기"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:visibility="gone" />

            <!-- 아이디찾기 / 비밀번호찾기 / 회원가입 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvFindId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아이디 찾기"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#D1D5DB" />

                <TextView
                    android:id="@+id/tvFindPw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 찾기"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#D1D5DB" />

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="회원가입"
                    android:textSize="13sp"
                    android:textColor="#4D80FF"
                    android:textStyle="bold"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

            </LinearLayout>

            <!-- 이용약관 텍스트 -->
            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="로그인 시 이용약관 및 개인정보 처리방침에 동의합니다."
                android:textSize="12sp"
                android:textColor="#9FA6AC"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>