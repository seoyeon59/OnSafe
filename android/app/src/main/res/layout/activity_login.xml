<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="64dp"
        android:paddingBottom="64dp">

        <!-- 로고 영역 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- 로고 아이콘 (다른 화면과 동일한 라운드 사각 배경으로 통일) -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_logo_login">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_neulbom_logo"
                    android:contentDescription="늘봄 로고"
                    app:tint="@color/surface_white" />
            </FrameLayout>

            <!-- 앱 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="늘봄"
                android:includeFontPadding="false"
                android:textSize="@dimen/text_brand"
                android:textColor="@color/primary_blue"
                android:fontFamily="@font/pretendard_bold"
                android:layout_marginTop="12dp"
                android:letterSpacing="-0.025" />

            <!-- 서브타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가족의 안전을 언제나 함께 지켜드립니다"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_500"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- 입력 + 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <!-- 입력 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <!-- 아이디 라벨 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아이디"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/ink_500"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- 아이디 입력칸 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_input_rounded">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_md"
                        android:src="@drawable/ic_person"
                        android:contentDescription="아이디 아이콘"
                        app:tint="@color/ink_500" />

                    <EditText
                        android:id="@+id/etId"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="아이디 입력"
                        android:textColor="@color/ink_900"
                        android:textSize="@dimen/text_body"
                        android:paddingStart="48dp"
                        android:paddingEnd="@dimen/space_md"
                        android:background="@null"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </FrameLayout>

                <!-- 비밀번호 라벨 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/ink_500"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- 비밀번호 입력칸 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_input_rounded">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_md"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="비밀번호 아이콘"
                        app:tint="@color/ink_500" />

                    <EditText
                        android:id="@+id/etPw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="비밀번호 입력"
                        android:textColor="@color/ink_900"
                        android:textSize="@dimen/text_body"
                        android:paddingStart="48dp"
                        android:paddingEnd="@dimen/touch_min"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <!-- 비밀번호 표시/숨김 버튼 -->
                    <!-- 아이콘은 24dp 그대로 보이되 padding으로 터치 영역만 48dp 확보 -->
                    <ImageButton
                        android:id="@+id/btnTogglePw"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:layout_gravity="center_vertical|end"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_eye"
                        android:background="@null"
                        android:contentDescription="비밀번호 보기"
                        app:tint="@color/ink_500" />
                </FrameLayout>

                <!-- 로그인 오류 메시지 -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/status_danger_text"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 로그인 버튼 -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_height="@dimen/btn_height"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="로그인"
                android:textColor="@color/surface_white"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                android:layout_marginTop="16dp" />

            <!-- 로그인 중 로딩 인디케이터 -->
            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="gone" />

            <!-- 디버그 전용 테스트 로그인 — 릴리즈에서는 BuildConfig.DEBUG 분기가 제거되어 gone 유지 -->
            <!-- 로그인 버튼과 같은 pill 계열이되 외곽선·낮은 높이·본문 크기로 한 단계 아래 위계 -->
            <Button
                android:id="@+id/btnDebugLogin"
                android:layout_width="match_parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_sm"
                android:includeFontPadding="false"
                android:background="@drawable/bg_button_outline_danger"
                android:stateListAnimator="@null"
                android:text="[DEBUG] 로그인 건너뛰기"
                android:textColor="@color/status_danger_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 아이디찾기 / 비밀번호찾기 / 회원가입 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvFindId"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:gravity="center"
                    android:text="아이디 찾기"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/ink_500"
                    android:paddingHorizontal="@dimen/space_sm" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/border_subtle" />

                <TextView
                    android:id="@+id/tvFindPw"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:gravity="center"
                    android:text="비밀번호 찾기"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/ink_500"
                    android:paddingHorizontal="@dimen/space_sm" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/border_subtle" />

                <!--
                  TODO: [UX] 회원가입은 신규 사용자의 유일한 진입점인데 찾기 링크와 같은 위계로
                        묻혀 있다. 터치 크기는 48dp로 보정했으나 위계 개선(별도 행 분리 등)은
                        디자인 확정 후 결정할 것.
                -->
                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:gravity="center"
                    android:text="회원가입"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:paddingHorizontal="@dimen/space_sm" />

            </LinearLayout>

            <!-- 이용약관 텍스트 -->
            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="로그인 시 이용약관 및 개인정보 처리방침에 동의합니다."
                android:textSize="@dimen/text_caption"
                android:textColor="@color/ink_500"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>