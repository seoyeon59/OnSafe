<?xml version="1.0" encoding="utf-8"?>
<!--
    API 30 이하 자동 백업 규칙 (API 31+는 data_extraction_rules.xml)
    https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
        auth_secure = TokenManager의 EncryptedSharedPreferences.
        Keystore 마스터 키는 백업 대상이 아니라 복원해도 복호화가 불가능하고,
        복원된 파일 때문에 EncryptedSharedPreferences.create()가 실패한다.
    -->
    <exclude domain="sharedpref" path="auth_secure.xml"/>
</full-backup-content>
