<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ 백업·기기 이전 규칙
    https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!--
        auth_secure = TokenManager의 EncryptedSharedPreferences.
        Keystore 마스터 키는 백업·이전 대상이 아니라 복원해도 복호화가 불가능하고,
        복원된 파일 때문에 EncryptedSharedPreferences.create()가 실패한다.
        (TokenManager가 실패 시 재생성으로 방어하지만, 애초에 옮기지 않는 편이 맞다)
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_secure.xml"/>
    </device-transfer>
</data-extraction-rules>
